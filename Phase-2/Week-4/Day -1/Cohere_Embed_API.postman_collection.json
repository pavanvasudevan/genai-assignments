{
  "info": {
    "name": "Cohere Embed API Examples",
    "_postman_id": "9b4d4b7d-cohere-embed-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sample Postman collection for Cohere Embed API covering text, image, multimodal and negative test scenarios."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.cohere.com/v2"
    },
    {
      "key": "apiKey",
      "value": "YOUR_COHERE_API_KEY"
    },
    {
      "key": "model",
      "value": "embed-v4.0"
    }
  ],
  "item": [
    {
      "name": "Single Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/embed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "embed"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{model}}\",\n  \"input_type\": \"search_document\",\n  \"texts\": [\n    \"Playwright is an automation framework.\"\n  ],\n  \"embedding_types\": [\n    \"float\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.expect(j).to.have.property('embeddings');"
            ]
          }
        }
      ]
    },
